<ResourceDictionary
    x:Class="AstralWarden.Nina.Beacon.Instructions.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:local="clr-namespace:AstralWarden.Nina.Beacon.Instructions"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <x:Array x:Key="AstralWardenSeverities" Type="{x:Type sys:String}">
        <sys:String>info</sys:String>
        <sys:String>warn</sys:String>
        <sys:String>error</sys:String>
    </x:Array>

    <DataTemplate DataType="{x:Type local:SendWardenAlertInstruction}">
        <nina:SequenceBlockView DataContext="{Binding}">
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Title" />
                    <TextBox
                        Width="180"
                        Margin="5,0,0,0"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="Severity" />
                    <ComboBox
                        Margin="5,0,0,0"
                        ItemsSource="{StaticResource AstralWardenSeverities}"
                        SelectedItem="{Binding Severity}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="Message" />
                    <TextBox
                        Width="300"
                        Margin="5,0,0,0"
                        Text="{Binding Message}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="AstralWarden.Nina.Beacon.Instructions.SendWardenAlertInstruction_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        MinWidth="40"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Title}"
                        TextAlignment="Right" />
                </StackPanel>
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>
</ResourceDictionary>
